    </edge>
    <edge source="Surgery" target="Surgical Menopause">
      <data key="d4">9.0</data>
      <data key="d5">Surgery that involves removal of ovaries results in surgical menopause if the patient hasn't reached natural menopause.</data>
      <data key="d6">surgical effects, hormonal changes</data>
