      <data key="d7">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </edge>
    <edge source="Squamous Cell Skin Cancer" target="Cryotherapy">
      <data key="d4">16.0</data>
      <data key="d5">Cryotherapy is a treatment method for squamous cell skin cancer and acts as a targeted therapy for skin lesions.&lt;SEP&gt;Cryotherapy serves as a treatment option for squamous cell skin cancer, aiming to destroy abnormal cells using extreme cold.</data>
