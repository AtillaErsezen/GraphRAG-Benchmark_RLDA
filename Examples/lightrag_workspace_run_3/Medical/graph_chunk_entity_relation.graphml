      <data key="d7">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </edge>
    <edge source="Ovarian Transposition" target="External Beam Radiation Therapy (EBRT)">
      <data key="d4">8.0</data>
      <data key="d5">Ovarian Transposition may be performed prior to EBRT to protect ovarian function during treatment.</data>
      <data key="d6">surgery, radiation protection</data>
      <data key="d7">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </edge>
    <edge source="Contrast" target="MRI">
      <data key="d4">8.0</data>
      <data key="d5">Contrast is used in MRI to enhance the clarity of the images obtained, aiding in precise cancer diagnosis.</data>
