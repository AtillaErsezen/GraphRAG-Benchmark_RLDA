      <data key="d7">chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </edge>
    <edge source="Contrast" target="Steroid Medication">
      <data key="d4">8.0</data>
      <data key="d5">Steroid Medication is used prior to administering Contrast in imaging tests to minimize allergic reactions.</data>
      <data key="d6">medical procedure, patient safety</data>
      <data key="d7">chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </edge>
    <edge source="Endoscopic Submucosal Dissection (ESD)" target="T1 Tumor">
      <data key="d4">8.0</data>
      <data key="d5">T1 tumors are considered ideal candidates for ESD, indicating an effective treatment option for early-stage rectal cancers.</data>
      <data key="d6">treatment suitability, early intervention</data>
