    <edge source="Niraparib" target="Stage 2 Ovarian Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Niraparib is also recommended for maintenance therapy in stage 2 ovarian cancer patients to prolong remission."}</data>
      <data key="d6">cancer treatment, maintenance therapy</data>
      <data key="d7">chunk-c622c677deca24391324ecd5f16ce4a3</data>
