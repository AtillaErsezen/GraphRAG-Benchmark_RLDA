      <data key="d6">symptoms, diagnosis</data>
      <data key="d7">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </edge>
    <edge source="Basal Cell Carcinoma" target="Family History">
      <data key="d4">8.0</data>
