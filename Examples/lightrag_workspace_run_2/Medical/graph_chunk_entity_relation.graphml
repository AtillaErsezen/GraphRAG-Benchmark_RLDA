      <data key="d1">geo</data>
      <data key="d2">Body refers to the entire physical structure of a person, which is examined during imaging tests to detect diseases.</data>
      <data key="d3">chunk-aeafa486bfd320cdaa7811ad75777912</data>
    </node>
