      <data key="d6">surgical procedure, post-operative care</data>
      <data key="d7">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </edge>
    <edge source="Colostomy" target="Chemotherapy Regimens">
      <data key="d4">7.0</data>
      <data key="d5">Colostomy may be required for patients whose anal cancer does not respond to chemotherapy regimens."&lt;&lt;"surgery necessity, treatment failure</data>
