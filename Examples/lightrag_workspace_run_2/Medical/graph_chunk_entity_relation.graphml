      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Racial Disparities">
      <data key="d0">Racial Disparities</data>
      <data key="d1">category</data>
      <data key="d2">Racial disparities highlight the differences in prostate cancer incidence and outcomes among different ethnic groups, especially regarding Black males.</data>
