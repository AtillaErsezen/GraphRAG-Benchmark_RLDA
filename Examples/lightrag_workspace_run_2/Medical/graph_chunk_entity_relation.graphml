    </edge>
    <edge source="Non-Clear Cell RCC (nccRCC)" target="Chromophobe RCC">
      <data key="d4">16.0</data>
      <data key="d5">Chromophobe RCC is another classification under non-clear cell RCC and requires specific histological identification.&lt;SEP&gt;Chromophobe RCC is another subtype of non-clear cell RCC and is characterized by distinct cellular features.</data>
