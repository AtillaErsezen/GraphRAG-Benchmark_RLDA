    </edge>
    <edge source="Chromophobe RCC" target="Renal Cell Carcinoma">
      <data key="d4">7.0</data>
      <data key="d5">Chromophobe RCC is recognized as a variant within the spectrum of Renal Cell Carcinoma types.</data>
