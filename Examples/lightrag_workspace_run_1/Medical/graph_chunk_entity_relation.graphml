    </edge>
    <edge source="Glioma" target="Oligodendrogliomas">
      <data key="d4">8.0</data>
      <data key="d5">Oligodendrogliomas are categorized as a type of glioma, originating from oligodendrocytes in the brain.</data>
      <data key="d6">classification, tumor types</data>
