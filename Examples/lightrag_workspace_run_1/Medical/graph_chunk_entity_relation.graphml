    </edge>
    <edge source="Glioma" target="Glioblastomas">
      <data key="d4">9.0</data>
      <data key="d5">Glioblastomas are recognized as the most destructive type of glioma, sharing a common origin in glial cells.</data>
      <data key="d6">classification, tumor types</data>
