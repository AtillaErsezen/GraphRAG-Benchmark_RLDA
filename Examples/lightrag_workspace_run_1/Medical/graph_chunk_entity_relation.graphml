      <data key="d7">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </edge>
    <edge source="Ivosidenib (Tibsovo)" target="IDH1 Mutation">
      <data key="d4">9.0</data>
      <data key="d5">Ivosidenib is specifically aimed at treating cancers with IDH1 mutations, helping target therapies effectively.</data>
