    </edge>
    <edge source="Ovarian Cancer" target="Intraperitoneal (IP) Chemotherapy">
      <data key="d4">17.0</data>
      <data key="d5">IP chemotherapy is specifically designed for ovarian cancer treatment, allowing for direct delivery of chemicals to areas affected by the disease.&lt;SEP&gt;IP chemotherapy is used as a targeted treatment for ovarian cancer, delivering drugs directly to cancer cells in the abdomen.</data>
      <data key="d6">targeted treatment, cancer care&lt;SEP&gt;targeted treatment, cancer strategy</data>
      <data key="d7">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </edge>
    <edge source="Ovarian Cancer" target="Maintenance Therapy">
