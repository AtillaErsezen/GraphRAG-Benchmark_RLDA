      <data key="d7">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </edge>
    <edge source="Lynch Syndrome" target="Bladder Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Individuals with Lynch syndrome have a heightened risk of developing bladder cancer due to genetic predisposition.</data>
