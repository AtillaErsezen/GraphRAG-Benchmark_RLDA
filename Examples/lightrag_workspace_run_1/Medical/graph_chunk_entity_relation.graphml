    <edge source="Glioma" target="Astrocytomas">
      <data key="d4">8.0</data>
      <data key="d5">Astrocytomas are a specific type of glioma characterized by their resemblance to star-shaped glial cells called astrocytes.</data>
      <data key="d6">classification, tumor types</data>
